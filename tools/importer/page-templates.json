{
  "templates": [
    {
      "name": "homepage",
      "urls": ["https://www.kampfkunstschule-fichtner.de/"],
      "description": "Kampfkunstschule Fichtner homepage with hero, program cards, events, locations, and partners",
      "blocks": [
        {
          "name": "hero",
          "instances": ["div.claim"]
        },
        {
          "name": "cards",
          "instances": [
            "section.bild_leiste .outter",
            "section.events .tab-content .row-eq-height",
            "section.standort-slider .owl-standort"
          ]
        },
        {
          "name": "columns",
          "instances": [
            "section.artikel-video .row",
            "section.partner-slider .owl-mini"
          ]
        },
        {
          "name": "section-intro",
          "instances": ["section.std-art"],
          "section": "center"
        },
        {
          "name": "section-events-heading",
          "instances": ["section.events .text-center"],
          "section": "center"
        },
        {
          "name": "section-locations-heading",
          "instances": ["section.standort-slider .col-md-12:first-child"],
          "section": "center"
        },
        {
          "name": "section-partners-heading",
          "instances": ["section.partner-slider .col-md-12:first-child"],
          "section": "center"
        }
      ]
    }
  ]
}
